{
	"name": "<%= libId %>",
	"version": "1.0.0",
	"description": "UI5 Library: <%= libId %>",
	"author": "<%= author %>",
	"license": "Apache-2.0",
	"types": "dist/index.d.ts",
	"files": [
		"LICENCE",
		"README.md",
		"tsconfig.json",
		"ui5.yaml",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"src",
		"test"
	],
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "ui5 build --clean-dest",
		"build:ts-interfaces": "npx @ui5/ts-interface-generator",
		"start": "ui5 serve -o test-resources/<%= libURI %>/Example.html",
		"start-coverage": "ui5 serve --port 8080 --config ui5-coverage.yaml",
		"start:dist": "npm start -- --config ui5-dist.yaml",
		"testsuite": "ui5 serve -o test-resources/<%= libURI %>/qunit/testsuite.qunit.html",
		"ts-typecheck": "tsc --noEmit",
		"lint": "eslint src test",
		"test-runner": "ui5-test-runner --url http://localhost:8080/test-resources/<%= libURI %>/qunit/testsuite.qunit.html",
		"test-runner-coverage": "ui5-test-runner --url http://localhost:8080/test-resources/<%= libURI %>/qunit/testsuite.qunit.html --coverage -ccb 50 -ccf 50 -ccl 50 -ccs 50",
		"test-ui5": "ui5-test-runner --start start-coverage --url http://localhost:8080/test-resources/<%= libURI %>/qunit/testsuite.qunit.html --coverage -ccb 50 -ccf 50 -ccl 50 -ccs 50",
		"test": "npm run lint && npm run test-ui5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"<%= tstypes %>": "<%= tstypesVersion %>",<% if (!gte1_100_0) { %>
		"@types/jquery": "^3.5.29",
		"@types/qunit": "^2.5.4",<% } %>
		"@ui5/cli": "^4.0.71",
		"@ui5/ts-interface-generator": "^0.12.0",
		"babel-plugin-istanbul": "^8.0.0",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"ui5-middleware-livereload": "^3.4.0",
		"ui5-test-runner": "^5.14.2",
		"ui5-tooling-transpile": "^3.14.0"
	}
}
